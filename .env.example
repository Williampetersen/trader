# Retrieve your GA ID from your GA dashboard
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-DFC4XLS37L

# Required: enables real OpenAI vision analysis in /api/analyses
# Uploads fail with a clear error if this is missing, so fake analysis is never saved.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe Checkout for paid plans
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd
STRIPE_PRICE_BASIC_ACCESS=price_xxx
STRIPE_PRICE_PRO_TRADER=price_xxx
STRIPE_PRICE_ADVANCED_TRADERS=price_xxx

# Support/contact email via SMTP
SUPPORT_EMAIL=support@gptchartview.com
SUPPORT_TO=support@gptchartview.com
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@gptchartview.com
SMTP_PASS=change-this-email-password
SMTP_FROM=support@gptchartview.com

# Optional webmaster verification tags
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional durable production storage for Vercel KV / Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GCV_DB_KEY=gpt-chart-view:db

# Owner dashboard login
OWNER_EMAIL=
OWNER_PASSWORD=
